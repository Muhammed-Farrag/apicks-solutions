# Google Identity Services (Frontend Client ID)
# Used by Google Identity Services on the web. Client ID is frontend-safe.
VITE_GOOGLE_CLIENT_ID=394221080004-unqtpq3mpofr7jom77b3nqvi0l9l7o5n.apps.googleusercontent.com

# Backend-only Google OAuth Client Secret
# IMPORTANT SECURITY: This must NEVER be prefixed with VITE_ and must NEVER be imported in frontend code.
# GOOGLE_CLIENT_SECRET=your_google_client_secret

# HTTPS endpoint accepting POST {"email":"..."} for email registration.
VITE_SIGNUP_API_URL=

# Contact service. Leave empty to use the Formspree endpoint in the reference site.
VITE_CONTACT_API_URL=