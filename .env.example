# HTTPS entry points supplied by your authentication provider.
# Each provider must handle its own OAuth state, PKCE, callback and session.
VITE_GOOGLE_AUTH_URL=
VITE_APPLE_AUTH_URL=

# HTTPS endpoint accepting POST {"email":"..."} for email registration.
VITE_SIGNUP_API_URL=

# Contact service. Leave empty to use the Formspree endpoint in the reference site.
VITE_CONTACT_API_URL=
